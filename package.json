{
  "name": "spendwise",
  "version": "1.0.0",
  "private": true,
  "description": "SpendWise - Expense & Budget Tracker",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed": "npm --prefix backend run db:seed",
    "report:pdf": "node scripts/update-report-pdf.js"
  },
  "dependencies": {
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
